# ZED Terminal environment template — copy to .env and fill in real values.
# NEVER commit .env (it is gitignored). Secrets stay server-side only; the
# settings vault exposes "key_set" booleans to the browser, never values.

# --- Core gateway (port 8000) ---
# Origins allowed to call the API/WS with credentials. Comma-separated.
ZED_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# --- LLM proxy (D4: key supplied later; P0-P2 run without it) ---
# ZED_LLM_PROVIDER=openrouter|deepseek|openai|anthropic|gemini|ollama
# ZED_LLM_MODEL=
# ZED_LLM_API_KEY=

# --- Optional data providers (unused until P4/P5/P6) ---
# ZED_FMP_API_KEY=
# ZED_WORLDMONITOR_API_KEY=

# --- Feature flags ---
ZED_LIVE_TRADING=false
